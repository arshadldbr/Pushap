# The GitHub personal access token (fine-grained, "Contents: Read and write"
# scoped ONLY to the practice repo below). Never share this or commit it.
GITHUB_TOKEN=

# The repo students are allowed to push to. This is hard-locked in server.js —
# no request from a student can ever target a different repo, no matter what
# they submit in the form.
REPO_OWNER=your-github-username
REPO_NAME=your-practice-repo

# Password for viewing the push log at /api/logs?password=... (separate from
# student access codes, this is for the teacher only).
ADMIN_PASSWORD=

PORT=3000
